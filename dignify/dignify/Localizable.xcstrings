      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 피드로 돌아가기"
          }
        }
      }
    },
    "Be the first to react": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 반응을 남겨보세요"
          }
        }
      }
    },
    "Beats and rhymes. The words are doing the work.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비트 위에 얹는 랩. 결국 가사가 다 한다"
          }
        }
      }
    },
    "Big choruses built to stick after one listen.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 듣고 흥얼거리게 되는 후렴을 만든다"
          }
        }
      }
    },
    "Block": {
